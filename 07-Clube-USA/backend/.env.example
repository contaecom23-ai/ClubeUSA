# Copy to .env and fill in real values.
# Never commit .env to version control.

# ── Supabase (server-side only — use service_role key) ───────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ── JWT — generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-a-long-random-string

# ── Email ─────────────────────────────────────────────────────────────────
# Leave SMTP_HOST empty to use console email (logs to stdout in dev).
EMAIL_FROM=noreply@clubeusa.com
EMAIL_FROM_NAME=Clube USA
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# ── App ───────────────────────────────────────────────────────────────────
# URL where the frontend is served (used in confirmation emails)
APP_URL=http://localhost:5500
ENVIRONMENT=development

# ── CORS — comma-separated allowed origins ────────────────────────────────
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
