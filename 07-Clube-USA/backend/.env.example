# ==============================
# Clube USA - Variáveis de Ambiente
# Copie para .env e preencha TODOS os valores antes de rodar
# ==============================

# Banco de dados (Supabase PostgreSQL connection string - Transaction Mode, porta 6543)
DATABASE_URL=postgresql://postgres:[SENHA]@[HOST]:6543/postgres

# Segurança — OBRIGATÓRIO em produção
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=

JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
EMAIL_CONFIRM_EXPIRE_HOURS=24

# Email (SMTP) — sem isso, links de confirmação só aparecem no log (modo dev)
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@clubeusa.com
SMTP_TLS=true

# CORS — origens permitidas separadas por vírgula
ALLOWED_ORIGINS=http://localhost:3000,https://clubeusa.com

# URL pública do app (usada nos links de email)
APP_URL=http://localhost:8000

# development | production
ENVIRONMENT=development
