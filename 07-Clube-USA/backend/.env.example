# Copie para .env e preencha. NUNCA comite o .env real.

# --- Obrigatórias ---

# PostgreSQL (Supabase: Settings > Database > Connection string > URI)
DATABASE_URL=postgresql://postgres:<senha>@db.<projeto>.supabase.co:5432/postgres

# Gere com: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=SUBSTITUA_POR_VALOR_ALEATORIO_FORTE

# --- Opcionais (defaults seguros) ---

DEBUG=false

# URL pública do frontend (para links de confirmação de email)
FRONTEND_URL=https://clubeusa.com

# CORS: separe com vírgula
ALLOWED_ORIGINS=https://clubeusa.com,https://www.clubeusa.com

# SMTP para envio de emails (deixe em branco para modo dev — loga no console)
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=SUA_CHAVE_SENDGRID
SMTP_FROM=noreply@clubeusa.com
