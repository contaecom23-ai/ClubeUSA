# Copy to .env and fill in your values. Never commit .env.

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=

# Supabase (use service_role key — never the anon key)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_KEY=

# CORS — comma-separated list of allowed origins (no trailing slash)
ALLOWED_ORIGINS=http://localhost:8000

# Cookie settings
COOKIE_SECURE=false        # Set to true in production (HTTPS required)
COOKIE_DOMAIN=             # Leave blank for localhost; set to .clubeusa.com in prod

# Public URL of the app (used in confirmation email link)
APP_URL=http://localhost:8000

# Email (SMTP) — see DECISOES.md for provider choice
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=
EMAIL_SMTP_PASSWORD=
EMAIL_FROM=noreply@clubeusa.com
