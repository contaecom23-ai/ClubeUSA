# OBRIGATÓRIAS — a API recusa iniciar sem elas
SECRET_KEY=              # gere com: openssl rand -hex 32
SUPABASE_URL=            # https://xxxx.supabase.co
SUPABASE_SERVICE_KEY=    # service_role key (nunca a anon key)

# Email via SMTP genérico (Gmail, SendGrid SMTP, AWS SES, etc.)
# Se não configurado, emails não são enviados (aviso no log)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seu@gmail.com
SMTP_PASS=senha_app_gmail
FROM_EMAIL=noreply@clubeusa.com

# URLs
BASE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:8080
ALLOWED_ORIGINS=http://localhost:8080,http://localhost:3000
