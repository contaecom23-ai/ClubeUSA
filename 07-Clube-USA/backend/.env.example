# Clube USA — variáveis de ambiente
# Copie para .env e preencha com os valores do seu projeto Supabase
# NUNCA commite o .env real

# Supabase (obtenha em: Project Settings > API)
SUPABASE_URL=https://xxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=eyJ...   # service_role key — APENAS no servidor, nunca no cliente
SUPABASE_JWT_SECRET=xxxxxxxxx  # JWT secret (Project Settings > API > JWT Settings)

# CORS: origens permitidas, separadas por vírgula
# Em produção: apenas o domínio do frontend
ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# Ambiente
ENVIRONMENT=development
