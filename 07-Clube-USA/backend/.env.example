# ─── Supabase ─────────────────────────────────────────────────────────────────
# Get these from: https://app.supabase.com → Project Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # NEVER expose client-side

# ─── JWT (auth tokens issued by our API) ──────────────────────────────────────
# Generate a strong secret: python -c "import secrets; print(secrets.token_hex(64))"
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_DAYS=7

# ─── SMTP (email confirmation) ────────────────────────────────────────────────
# Recommended provider: Resend.io (3k emails/month free, excellent deliverability)
#   SMTP host: smtp.resend.com  port: 587  user: resend  pass: re_your_api_key
# Alternative: SendGrid, AWS SES, Gmail (Gmail limited to 500/day — not for prod)
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASSWORD=your-resend-api-key
EMAIL_FROM=noreply@clubeusa.com

# ─── App ──────────────────────────────────────────────────────────────────────
APP_URL=https://clubeusa.com
# Comma-separated list of allowed CORS origins
ALLOWED_ORIGINS=https://clubeusa.com
DEBUG=false
