# Clube USA — Backend Environment Variables
# Copy to .env and fill in real values. NEVER commit .env.

# ---- Supabase ----
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key   # never the anon key

# ---- JWT ----
# Generate with: python -c "import secrets; print(secrets.token_hex(64))"
SECRET_KEY=REPLACE_WITH_RANDOM_64_BYTE_HEX

# ---- App ----
ENVIRONMENT=development                       # development | production
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# ---- Email (choose one provider — see DECISOES.md) ----
EMAIL_FROM=noreply@clubeusa.com
# SENDGRID_API_KEY=...
# AWS_SES_REGION=us-east-1
# RESEND_API_KEY=...

# Base URL used in confirmation links
APP_BASE_URL=http://localhost:8000
