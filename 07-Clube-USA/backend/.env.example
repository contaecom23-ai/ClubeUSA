# -------------------------------------------------------
# Clube USA Backend — variáveis de ambiente obrigatórias
# Copie para .env e preencha com valores reais.
# NUNCA commite o .env com valores reais.
# -------------------------------------------------------

# Supabase (painel > Settings > API)
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...
SUPABASE_JWT_SECRET=seu-jwt-secret-do-supabase

# App
APP_ENV=development
FRONTEND_URL=http://localhost:8000
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Rate limits (formato: N/minute | N/hour)
RATE_LIMIT_REGISTER=5/minute
RATE_LIMIT_LOGIN=10/minute
