# Clube USA — backend environment variables
# Copie para .env e preencha com os valores reais do seu projeto Supabase.
# NUNCA comite o arquivo .env no git.

# Supabase — painel: Settings > API
SUPABASE_URL=https://SEU_PROJETO.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Supabase — painel: Settings > API > JWT Settings > JWT Secret
SUPABASE_JWT_SECRET=sua-jwt-secret-aqui

# URL pública da aplicação (usada no link de confirmação de email)
SITE_URL=http://localhost:8000

# CORS — origens permitidas (separadas por vírgula)
CORS_ORIGINS=http://localhost:8000

# Ambiente: development | production
APP_ENV=development
