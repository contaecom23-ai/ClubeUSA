# =====================================================================
# CLUBE USA — Backend Environment Variables
# Copie para .env e preencha. NUNCA comite .env no git.
# =====================================================================

# Supabase (painel: Settings > API)
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_SERVICE_KEY=eyJ...  # service_role key, NUNCA a anon key

# JWT — gere com: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=GERE_UM_VALOR_ALEATORIO_AQUI

# Email (SMTP) — necessário para enviar confirmação de email em produção
# Em dev, EMAIL_ENABLED=false loga o link no console
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=SG.xxxx
SMTP_FROM=noreply@clubeusa.com
EMAIL_ENABLED=false

# URLs
FRONTEND_URL=http://localhost:8080
# Origens permitidas no CORS (separadas por vírgula, sem espaço)
ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
