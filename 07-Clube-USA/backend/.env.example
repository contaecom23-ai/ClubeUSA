# Clube USA — Backend — variáveis de ambiente
# Copie para .env e preencha (NUNCA comite o .env real)

# Banco de dados (Supabase — Connection String da aba "Database > Connection string > URI")
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres

# Chave secreta JWT — gere com: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=

# Email (deixe em branco para modo console durante desenvolvimento)
EMAIL_FROM=noreply@clubeusa.com
EMAIL_FROM_NAME=Clube USA
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=true

# URL base do app (para links nos emails e CORS)
APP_URL=http://localhost:8000
ALLOWED_ORIGINS=http://localhost:8000,http://localhost:3000
