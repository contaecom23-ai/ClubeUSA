# ============================================================
# Clube USA — Backend — Variáveis de Ambiente
# Copie para .env e preencha. Nunca commite o .env real.
# ============================================================

# Supabase (pegue em: Dashboard > Project Settings > API)
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...sua-service-role-key

# JWT — gere com: python -c "import secrets; print(secrets.token_urlsafe(32))"
# NUNCA use um valor fixo/previsível em produção.
SECRET_KEY=gere-uma-chave-aleatoria-aqui
ACCESS_TOKEN_TTL_DAYS=7

# URLs da aplicação
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
# Origens permitidas no CORS (separadas por vírgula)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# Email (veja DECISOES.md para a escolha do provedor)
# Opções: console | sendgrid | resend
EMAIL_PROVIDER=console
EMAIL_FROM=noreply@clubeusa.com
# EMAIL_API_KEY=sua-api-key   # necessário para sendgrid ou resend
