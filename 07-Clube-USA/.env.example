# ──────────────────────────────────────────────────────────────────────────────
# Clube USA API — Environment Variables
# Copy to .env and fill in real values. NEVER commit .env to git.
# ──────────────────────────────────────────────────────────────────────────────

# Required — Supabase (get from https://supabase.com/dashboard/project/_/settings/api)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key-here   # service_role, NOT anon key

# Required — JWT signing (generate: python -c "import secrets; print(secrets.token_urlsafe(48))")
SECRET_KEY=REPLACE_WITH_RANDOM_64_CHAR_STRING

# App
APP_URL=http://localhost:8000
ENVIRONMENT=development            # development | production
ACCESS_TOKEN_EXPIRE_DAYS=7
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# SMTP email (leave blank in development — emails logged to console instead)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@clubeusa.com
SMTP_USE_TLS=true
