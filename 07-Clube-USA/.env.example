# ============================================================
#  .env.example — Clube USA
#  Copie para .env e preencha os valores reais
#  NUNCA commite o .env no git
# ============================================================

# --- Supabase (banco de dados) ---
# Criar em: https://supabase.com → Settings → API
SUPABASE_URL=https://XXXXXXXXXXXX.supabase.co
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# --- Mensageiro ativo: "telegram" ou "zapi" ---
MESSENGER=telegram

# --- Telegram Bot ---
# Criar em: https://t.me/BotFather
TELEGRAM_BOT_TOKEN=bot123456789:AAAA...
# IDs dos canais/grupos (use @username ou -100xxxxxxxxxx)
TELEGRAM_CHANNEL_PT=-100xxxxxxxxxx
TELEGRAM_CHANNEL_ES=-100xxxxxxxxxx

# --- Z-API (WhatsApp) — opcional se MESSENGER=zapi ---
# Criar em: https://z-api.io → Instancias
ZAPI_INSTANCE=SEU_ID_DE_INSTANCIA
ZAPI_TOKEN=SEU_TOKEN
ZAPI_CLIENT_TOKEN=SEU_CLIENT_TOKEN

# --- Seguranca (gerar com: python clubeusa/utils/security.py) ---
JWT_SECRET=gere_com_python_secrets_token_hex_32
ENCRYPTION_KEY=gere_com_base64_urlsafe_b64encode_os_urandom_32
ADMIN_SECRET=token-longo-para-proteger-o-painel-admin

# --- Amazon Associates ---
# Ativar apos 3 vendas: https://affiliate-program.amazon.com/
AMAZON_PARTNER_TAG=clubeusa-20
AMAZON_ACCESS_KEY=SUA_ACCESS_KEY
AMAZON_SECRET_KEY=SUA_SECRET_KEY

# --- Stripe (pagamento VIP) ---
# Criar em: https://dashboard.stripe.com
STRIPE_SECRET_KEY=sk_test_XXXXX
STRIPE_WEBHOOK_SECRET=whsec_XXXXX
STRIPE_VIP_PRICE_ID=price_XXXXX

# --- AI (traducao e copy) ---
# Criar em: https://console.groq.com
GROQ_API_KEY=gsk_XXXXXXXXXXXXXXXXXXXXXXXX

# --- App ---
APP_URL=https://clubeusa.com
ENVIRONMENT=development
PORT=8000
