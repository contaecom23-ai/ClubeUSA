# ============================================================
#  Clube USA — variaveis de ambiente
#  Copie para .env e preencha com credenciais reais.
#  NUNCA commite o .env (ja esta no .gitignore).
# ============================================================

# --- Ambiente ---
ENVIRONMENT=development          # development | production
PORT=8000
APP_URL=https://clubeusa.com     # URL publica do site (usada nos redirects do Stripe)

# --- Supabase (Settings > API) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=            # NUNCA expor no frontend

# --- Seguranca (gerar com: python utils/security.py) ---
ENCRYPTION_KEY=
JWT_SECRET=
ADMIN_SECRET=                    # senha do painel admin (api/deps.py)

# --- WhatsApp (Z-API) ---
ZAPI_INSTANCE=
ZAPI_TOKEN=
ZAPI_CLIENT_TOKEN=

# --- Stripe (dashboard.stripe.com) ---
STRIPE_SECRET_KEY=               # sk_live_... ou sk_test_...
STRIPE_WEBHOOK_SECRET=           # whsec_... (Developers > Webhooks > endpoint)
STRIPE_VIP_PRICE_ID=             # price_... do produto VIP ($4.99/mes)

# --- E-mail SMTP (Fase 0.1 — confirmacao de e-mail) ---
# Opcoes: Mailgun, SendGrid, Resend, AWS SES, Brevo. Em dev: deixe vazio (loga no console).
SMTP_HOST=                       # ex: smtp.mailgun.org
SMTP_PORT=587                    # 587=TLS (recomendado) | 465=SSL
SMTP_USER=                       # ex: postmaster@mg.clubeusa.com
SMTP_PASSWORD=                   # senha SMTP (NUNCA commitar)
SMTP_FROM=noreply@clubeusa.com   # remetente exibido
SMTP_TLS=true                    # true=STARTTLS | false=SSL direto
