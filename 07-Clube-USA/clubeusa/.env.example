# ============================================================
#  Clube USA — variaveis de ambiente
#  Copie para .env e preencha com credenciais reais.
#  NUNCA commite o .env (ja esta no .gitignore).
# ============================================================

# --- Ambiente ---
ENVIRONMENT=development          # development | production
PORT=8000
APP_URL=https://clubeusa.com     # URL publica do site (usada nos redirects do Stripe)

# --- Supabase (Settings > API) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=            # NUNCA expor no frontend

# --- Seguranca (gerar com: python utils/security.py) ---
ENCRYPTION_KEY=
JWT_SECRET=
ADMIN_SECRET=                    # senha do painel admin (api/deps.py)

# --- WhatsApp (Z-API) ---
ZAPI_INSTANCE=
ZAPI_TOKEN=
ZAPI_CLIENT_TOKEN=

# --- Stripe (dashboard.stripe.com) ---
STRIPE_SECRET_KEY=               # sk_live_... ou sk_test_...
STRIPE_WEBHOOK_SECRET=           # whsec_... (Developers > Webhooks > endpoint)
STRIPE_VIP_PRICE_ID=             # price_... do produto VIP ($4.99/mes)

# --- Email / SMTP (confirmacao de email — Fase 0.1) ---
# Provedores recomendados: Resend (resend.com), SendGrid, ou qualquer SMTP STARTTLS.
# Se nao configurado, o sistema funciona normalmente mas nao envia emails.
SMTP_HOST=                       # ex: smtp.resend.com | smtp.sendgrid.net
SMTP_PORT=587                    # 587 para STARTTLS (recomendado)
SMTP_USER=                       # ex: apikey (SendGrid) | resend (Resend)
SMTP_PASS=                       # chave de API do provedor
FROM_EMAIL=noreply@clubeusa.com  # endereco remetente visivel
