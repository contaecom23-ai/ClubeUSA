# ============================================================
#  Clube USA — variaveis de ambiente
#  Copie para .env e preencha com credenciais reais.
#  NUNCA commite o .env (ja esta no .gitignore).
# ============================================================

# --- Ambiente ---
ENVIRONMENT=development          # development | production
PORT=8000
APP_URL=https://clubeusa.com     # URL publica do site (usada nos redirects do Stripe)

# --- Supabase (Settings > API) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=            # NUNCA expor no frontend

# --- Seguranca (gerar com: python utils/security.py) ---
ENCRYPTION_KEY=
JWT_SECRET=
ADMIN_SECRET=                    # senha do painel admin (api/deps.py)

# --- WhatsApp (Z-API) ---
ZAPI_INSTANCE=
ZAPI_TOKEN=
ZAPI_CLIENT_TOKEN=

# --- Stripe (dashboard.stripe.com) ---
STRIPE_SECRET_KEY=               # sk_live_... ou sk_test_...
STRIPE_WEBHOOK_SECRET=           # whsec_... (Developers > Webhooks > endpoint)
STRIPE_VIP_PRICE_ID=             # price_... do produto VIP ($4.99/mes)

# --- Email (Fase 0.1 — confirmacao de email) ---
# Em dev (sem EMAIL_PROVIDER) apenas loga o link no console, sem envio real.
# Ver DECISOES.md para escolha do provedor.
EMAIL_PROVIDER=                  # "resend" | "smtp" | "" (dev/log)
EMAIL_FROM=Clube USA <noreply@clubeusa.com>

# Se EMAIL_PROVIDER=resend:
RESEND_API_KEY=                  # re_...

# Se EMAIL_PROVIDER=smtp (ex: Amazon SES):
SMTP_HOST=                       # ex: email-smtp.us-east-1.amazonaws.com
SMTP_PORT=587
SMTP_USER=                       # usuario SMTP
SMTP_PASS=                       # senha SMTP
