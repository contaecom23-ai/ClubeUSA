# ============================================================
#  Clube USA — variaveis de ambiente
#  Copie para .env e preencha com credenciais reais.
#  NUNCA commite o .env (ja esta no .gitignore).
# ============================================================

# --- Ambiente ---
ENVIRONMENT=development          # development | production
PORT=8000
APP_URL=https://clubeusa.com     # URL publica do site (usada nos redirects do Stripe)

# --- Supabase (Settings > API) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=            # NUNCA expor no frontend

# --- Seguranca (gerar com: python utils/security.py) ---
ENCRYPTION_KEY=
JWT_SECRET=
ADMIN_SECRET=                    # senha do painel admin (api/deps.py)

# --- WhatsApp (Z-API) ---
ZAPI_INSTANCE=
ZAPI_TOKEN=
ZAPI_CLIENT_TOKEN=

# --- Stripe (dashboard.stripe.com) ---
STRIPE_SECRET_KEY=               # sk_live_... ou sk_test_...
STRIPE_WEBHOOK_SECRET=           # whsec_... (Developers > Webhooks > endpoint)
STRIPE_VIP_PRICE_ID=             # price_... do produto VIP ($4.99/mes)

# --- Email (SMTP) --- Opcional em dev; obrigatorio em producao para confirmacao de email
# Compativel com Gmail (porta 587), SendGrid, AWS SES, Mailgun, etc.
SMTP_HOST=                       # ex: smtp.gmail.com | smtp.sendgrid.net
SMTP_PORT=587                    # 587 (STARTTLS) ou 465 (SSL)
SMTP_USER=                       # ex: seuemail@gmail.com | apikey (SendGrid)
SMTP_PASS=                       # App Password (Gmail) ou API Key (SendGrid)
FROM_EMAIL=                      # ex: noreply@clubeusa.com (opcional; usa SMTP_USER se vazio)
