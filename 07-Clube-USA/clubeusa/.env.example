# ============================================================
#  Clube USA — variaveis de ambiente
#  Copie para .env e preencha com credenciais reais.
#  NUNCA commite o .env (ja esta no .gitignore).
# ============================================================

# --- Ambiente ---
ENVIRONMENT=development          # development | production
PORT=8000
APP_URL=https://clubeusa.com     # URL publica do site (usada nos redirects do Stripe e links de email)

# --- Supabase (Settings > API) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=            # NUNCA expor no frontend

# --- Seguranca (gerar com: python utils/security.py) ---
ENCRYPTION_KEY=
JWT_SECRET=
ADMIN_SECRET=                    # senha do painel admin (api/deps.py)

# --- WhatsApp (Z-API) ---
ZAPI_INSTANCE=
ZAPI_TOKEN=
ZAPI_CLIENT_TOKEN=

# --- Email SMTP (para confirmacao de email — Fase 0.1) ---
# Recomendado: Resend (resend.com) — free ate 3k emails/mes
# SMTP_HOST=smtp.resend.com       # ou smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USER=resend                # ou "apikey" no SendGrid
# SMTP_PASSWORD=                  # chave API do provedor
# FROM_EMAIL=noreply@clubeusa.com # requer dominio verificado no provedor
# Em dev sem SMTP configurado: o link de confirmacao e logado no servidor (nao envia email)

# --- Stripe (dashboard.stripe.com) ---
STRIPE_SECRET_KEY=               # sk_live_... ou sk_test_...
STRIPE_WEBHOOK_SECRET=           # whsec_... (Developers > Webhooks > endpoint)
STRIPE_VIP_PRICE_ID=             # price_... do produto VIP ($4.99/mes)

# --- Email transacional (Fase 0.1 — confirmacao de email) ---
# Escolha UM provider. Em dev sem configurar, apenas loga o link.
# Ver DECISOES.md #001 para recomendacao de provider.

EMAIL_FROM=noreply@clubeusa.com  # remetente (requer dominio verificado no provider)

# Resend (https://resend.com — free tier: 3k emails/mes, RECOMENDADO)
RESEND_API_KEY=                  # re_...

# SMTP alternativo (Gmail, Mailgun SMTP, etc.) — usado se RESEND_API_KEY nao configurado
SMTP_HOST=                       # ex: smtp.gmail.com | smtp.sendgrid.net
SMTP_PORT=587                    # 587 (STARTTLS) ou 465 (SSL)
SMTP_USER=                       # ex: seuemail@gmail.com | apikey (SendGrid)
SMTP_PASS=                       # App Password (Gmail) ou API Key (SendGrid)
