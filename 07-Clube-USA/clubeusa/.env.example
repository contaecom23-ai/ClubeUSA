# ============================================================
#  Clube USA — variáveis de ambiente
#  Copie para .env e preencha com credenciais reais.
#  NUNCA commite o .env (já está no .gitignore).
# ============================================================

# --- Ambiente ---
ENVIRONMENT=development          # development | production
PORT=8000
APP_URL=https://clubeusa.com     # URL pública do site (usada nos redirects do Stripe e emails)

# --- Supabase (Settings > API) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=            # NUNCA expor no frontend

# --- Segurança (gerar com: python utils/security.py) ---
ENCRYPTION_KEY=
JWT_SECRET=
ADMIN_SECRET=                    # senha do painel admin (api/deps.py)

# --- WhatsApp (Z-API) ---
ZAPI_INSTANCE=
ZAPI_TOKEN=
ZAPI_CLIENT_TOKEN=

# --- Stripe (dashboard.stripe.com) ---
STRIPE_SECRET_KEY=               # sk_live_... ou sk_test_...
STRIPE_WEBHOOK_SECRET=           # whsec_... (Developers > Webhooks > endpoint)
STRIPE_VIP_PRICE_ID=             # price_... do produto VIP ($4.99/mes)

# --- Email / SMTP (para confirmação de email — Fase 0.1) ---
# Qualquer provedor SMTP: Gmail, SendGrid, Resend, Mailgun, SES, etc.
# Em ENVIRONMENT=development, emails são logados (não enviados).
SMTP_HOST=smtp.gmail.com         # ex: smtp.sendgrid.net / smtp.resend.com
SMTP_PORT=587                    # 587 (TLS) ou 465 (SSL)
SMTP_USER=                       # endereço de envio (ou API user no SendGrid)
SMTP_PASS=                       # senha ou API key
SMTP_FROM=Clube USA <noreply@clubeusa.com>  # nome exibido no email
